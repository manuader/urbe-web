---
/**
 * Intro de marca (solo home, una vez por sesión).
 * Secuencia (~2,7 s, todo CSS: si el JS falla, la cortina igual se retira sola):
 *   0,15 s  la U se traza sobre su eje
 *   0,60 s  el pin cae, comprime y se asienta; una onda marca el lugar
 *   0,95 s  el logotipo entra letra por letra
 *   0,20 s → 1,85 s  el filete violeta → naranja se llena ("cargando")
 *   1,95 s  el logo se retira hacia arriba y la cortina sube
 * Se saltea con clic o tecla. Con prefers-reduced-motion no se muestra.
 */
import vertical from '../../public/brand/urbetrack-logo-vertical-color.svg?raw';

const AXIS = 'M261.15 358 V414.2 C261.15 438.5 275.6 451.3 295.3 451.3 C315 451.3 329.6 438.5 329.6 414.2 V358';
let i = 0;
let svg = vertical
  .replace(/<title>.*?<\/title>/, '')
  .replace(/role="img"\s*/, '')
  .replace(/aria-label="[^"]*"\s*/, '')
  .replace(/<path([^>]*)\/>/g, (_m, attrs) => {
    const k = i++;
    if (k === 0) return `<path class="it-u" mask="url(#it-m)"${attrs}/>`;
    if (k === 1) return `<g class="it-pin"><path${attrs}/></g>`;
    return `<path class="it-l" style="--i:${k - 2}"${attrs}/>`;
  });
svg = svg.replace(
  /<svg([^>]*)>/,
  `<svg$1 aria-hidden="true" focusable="false" overflow="visible"><defs><mask id="it-m" maskUnits="userSpaceOnUse" x="240" y="340" width="110" height="130"><path class="it-mask" d="${AXIS}" fill="none" stroke="#fff" stroke-width="17" pathLength="1"/></mask></defs><ellipse class="it-ring" cx="295.27" cy="436" rx="22" ry="6.5"/><ellipse class="it-ring it-ring--2" cx="295.27" cy="436" rx="22" ry="6.5"/>`,
);
---
<script is:inline>
  (function () {
    var d = document.documentElement;
    try {
      var force = /[?&]intro=1/.test(location.search);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || (!force && sessionStorage.getItem('u-intro'))) { d.dataset.intro = 'skip'; return; }
      sessionStorage.setItem('u-intro', '1');
      sessionStorage.setItem('u-logo', '1');
    } catch (e) {}
    d.dataset.intro = 'play';
    d.dataset.logo = 'static';
  })();
</script>
<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__glow"></div>
  <div class="intro__mark">
    <div class="intro__logo"><Fragment set:html={svg} /></div>
    <span class="intro__bar"><i></i></span>
  </div>
</div>

<style is:global>
  .intro { display: none; }
  html[data-intro="play"] .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 1000;
    background: var(--u-estudio); cursor: pointer;
    animation: it-curtain .75s cubic-bezier(.76, 0, .24, 1) 1.95s forwards;
  }
  html[data-intro="play"] { overflow: hidden; animation: it-unlock 0s 2.1s forwards; }
  @keyframes it-unlock { to { overflow: auto; } }
  html[data-intro="done"] .intro { display: none; }

  .intro__glow {
    position: absolute; width: 520px; height: 520px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(220, 207, 234, .75), rgba(239, 233, 246, 0));
    animation: it-glow 1.9s cubic-bezier(.22, 1, .36, 1) both;
  }
  .intro__mark { position: relative; display: grid; justify-items: center; gap: 30px; animation: it-exit .6s cubic-bezier(.65, 0, .35, 1) 1.9s forwards; }
  .intro__logo { width: clamp(132px, 18vw, 176px); }
  .intro__logo svg { width: 100%; height: auto; display: block; overflow: visible; }

  .intro .it-mask { stroke-dasharray: 1; stroke-dashoffset: 1; animation: it-draw .75s cubic-bezier(.65, 0, .35, 1) .15s forwards; }
  .intro .it-pin { transform-box: fill-box; transform-origin: 50% 100%; opacity: 0; animation: it-drop .8s .6s forwards; }
  .intro .it-l { transform-box: fill-box; opacity: 0; animation: it-letter .6s cubic-bezier(.22, 1, .36, 1) forwards; animation-delay: calc(.95s + var(--i) * 45ms); }
  .intro .it-ring { fill: none; stroke: var(--u-pin); stroke-width: 1.2; opacity: 0; transform-box: fill-box; transform-origin: center; animation: it-ring 1.1s cubic-bezier(.22, 1, .36, 1) 1.05s forwards; }
  .intro .it-ring--2 { stroke: var(--u-violeta); animation-delay: 1.22s; }

  .intro__bar { position: relative; width: 132px; height: 3px; border-radius: 3px; background: var(--u-lavanda-2); overflow: hidden; opacity: 0; animation: it-fade .4s ease .2s forwards; }
  .intro__bar i { position: absolute; inset: 0; background: var(--u-grad); transform-origin: left; transform: scaleX(0); animation: it-load 1.65s cubic-bezier(.65, 0, .35, 1) .2s forwards; }

  @keyframes it-draw { to { stroke-dashoffset: 0; } }
  @keyframes it-drop {
    0% { opacity: 0; transform: translateY(-120%) scale(.92); animation-timing-function: cubic-bezier(.55, 0, .9, .45); }
    12% { opacity: 1; }
    55% { opacity: 1; transform: translateY(0) scale(1.1, .84); animation-timing-function: cubic-bezier(.22, 1, .36, 1); }
    76% { opacity: 1; transform: translateY(-8%) scale(.97, 1.04); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes it-letter { from { opacity: 0; transform: translateY(40%); } to { opacity: 1; transform: none; } }
  @keyframes it-ring { 0% { opacity: .9; transform: scale(.3); } 100% { opacity: 0; transform: scale(2.6); } }
  @keyframes it-load { 0% { transform: scaleX(0); } 60% { transform: scaleX(.72); } 100% { transform: scaleX(1); } }
  @keyframes it-fade { to { opacity: 1; } }
  @keyframes it-glow { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
  @keyframes it-exit { to { opacity: 0; transform: translateY(-18px) scale(.97); } }
  @keyframes it-curtain { 0% { clip-path: inset(0 0 0 0); } 100% { clip-path: inset(0 0 100% 0); visibility: hidden; pointer-events: none; } }

  /* El hero entra mientras sube la cortina */
  html[data-intro="play"] .in, html[data-intro="done"] .in { animation-delay: calc(var(--d, 0s) + 2.05s) !important; }
  html[data-intro="play"] .rv-line.in > span, html[data-intro="done"] .rv-line.in > span { animation-delay: calc(var(--d, 0s) + 2.05s) !important; }

  /* Salteada con clic o tecla: todo termina de golpe */
  html[data-intro="skipped"] .intro { display: none; }
  html[data-intro="skipped"] .in, html[data-intro="skipped"] .rv-line.in > span { animation-delay: var(--d, 0s) !important; }

  @media (prefers-reduced-motion: reduce) { .intro { display: none !important; } }
</style>

<script>
  const d = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && d.dataset.intro === 'play') {
    let finished = false;
    const finish = (skipped: boolean) => {
      if (finished) return;
      finished = true;
      d.dataset.intro = skipped ? 'skipped' : 'done';
      d.style.overflow = '';
      window.dispatchEvent(new Event('u:intro-done'));
      removeEventListener('keydown', onKey);
    };
    const onKey = () => finish(true);
    el.addEventListener('click', () => finish(true));
    addEventListener('keydown', onKey);
    el.addEventListener('animationend', (e) => { if (e.animationName === 'it-curtain') finish(false); });
    setTimeout(() => finish(false), 3200); // resguardo
  }
</script>
