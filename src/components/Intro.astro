---
/**
 * Intro de marca (solo home, una vez por sesión). Todo CSS: si el JS falla, la cortina se retira sola.
 *   0,10 s  la grilla de puntos del sistema aparece desde el centro
 *   0,20 s  la U se traza sobre su eje, con una luz violeta en la punta del trazo
 *   0,85 s  el pin cae, comprime y se asienta; anillos concéntricos marcan el lugar
 *   1,10 s  el logotipo se contrae desde un tracking amplio, letra por letra
 *   1,55 s  firma "Inteligencia en tu gestión" y brillo que barre el logo
 *   0,25 → 2,05 s  el filete violeta → naranja se llena ("cargando")
 *   2,15 s  el logo se retira y la cortina sube sobre el hero
 * Se saltea con clic o tecla. Con prefers-reduced-motion no se muestra. ?intro=1 la fuerza.
 */
import vertical from '../../public/brand/urbetrack-logo-vertical-color.svg?raw';

const AXIS = 'M261.15 358 V414.2 C261.15 438.5 275.6 451.3 295.3 451.3 C315 451.3 329.6 438.5 329.6 414.2 V358';
let i = 0;
let svg = vertical
  .replace(/<title>.*?<\/title>/, '')
  .replace(/role="img"\s*/, '')
  .replace(/aria-label="[^"]*"\s*/, '')
  .replace(/<path([^>]*)\/>/g, (_m, attrs) => {
    const k = i++;
    if (k === 0) return `<path class="it-u" mask="url(#it-m)"${attrs}/>`;
    if (k === 1) return `<g class="it-pin"><path${attrs}/></g>`;
    return `<path class="it-l" style="--i:${k - 2};--o:${k - 2 - 4}"${attrs}/>`;
  });
svg = svg.replace(
  /<svg([^>]*)>/,
  `<svg$1 aria-hidden="true" focusable="false" overflow="visible"><defs>
    <mask id="it-m" maskUnits="userSpaceOnUse" x="240" y="340" width="110" height="130"><path class="it-mask" d="${AXIS}" fill="none" stroke="#fff" stroke-width="17" pathLength="1"/></mask>
    <radialGradient id="it-spark"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#B79BD9"/><stop offset="1" stop-color="#6E4299" stop-opacity="0"/></radialGradient>
  </defs>
  <circle class="it-tracer" r="9" fill="url(#it-spark)" style="offset-path:path('${AXIS}')"/>
  <ellipse class="it-ping" cx="295.27" cy="436" rx="20" ry="6"/>`,
);
---
<script is:inline>
  (function () {
    var d = document.documentElement;
    try {
      var force = /[?&]intro=1/.test(location.search);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || (!force && sessionStorage.getItem('u-intro'))) { d.dataset.intro = 'skip'; return; }
      sessionStorage.setItem('u-intro', '1');
      sessionStorage.setItem('u-logo', '1');
    } catch (e) {}
    d.dataset.intro = 'play';
    d.dataset.logo = 'static';
  })();
</script>
<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__grid"></div>
  <div class="intro__glow"></div>
  <div class="intro__rings"><i></i><i></i><i></i></div>
  <div class="intro__mark">
    <div class="intro__logo"><Fragment set:html={svg} /><span class="intro__sheen"></span></div>
    <p class="intro__sig">Inteligencia en tu gestión</p>
    <span class="intro__bar"><i></i></span>
  </div>
</div>

<style is:global>
  .intro { display: none; }
  html[data-intro="play"] .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 1000; overflow: hidden;
    background: var(--u-estudio); cursor: pointer;
    animation: it-curtain .85s cubic-bezier(.76, 0, .24, 1) 2.15s forwards;
  }
  html[data-intro="play"] { overflow: hidden; animation: it-unlock 0s 2.3s forwards; }
  @keyframes it-unlock { to { overflow: auto; } }
  html[data-intro="done"] .intro, html[data-intro="skipped"] .intro { display: none; }

  /* Fondo: grilla de puntos del sistema que se revela desde el centro, y halo lavanda */
  .intro__grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(110, 66, 153, .16) 1px, transparent 0);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0, transparent var(--r, 0%));
    mask-image: radial-gradient(circle at 50% 50%, #000 0, transparent var(--r, 0%));
    animation: it-grid 1.8s cubic-bezier(.22, 1, .36, 1) .1s forwards;
  }
  @property --r { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  @keyframes it-grid { to { --r: 62%; } }
  .intro__glow {
    position: absolute; width: min(760px, 120vw); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(220, 207, 234, .85), rgba(239, 233, 246, .35) 55%, rgba(239, 233, 246, 0));
    animation: it-glow 2s cubic-bezier(.22, 1, .36, 1) both;
  }

  /* Anillos concéntricos cuando cae el pin */
  .intro__rings { position: absolute; width: clamp(220px, 30vw, 360px); aspect-ratio: 1; display: grid; place-items: center; transform: translateY(-8%); }
  .intro__rings i {
    position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(110, 66, 153, .38);
    opacity: 0; transform: scale(.55);
    animation: it-rings 1.6s cubic-bezier(.22, 1, .36, 1) forwards;
  }
  .intro__rings i:nth-child(1) { animation-delay: 1.02s; }
  .intro__rings i:nth-child(2) { animation-delay: 1.16s; border-color: rgba(183, 155, 217, .45); }
  .intro__rings i:nth-child(3) { animation-delay: 1.3s; border-color: rgba(238, 120, 36, .35); }

  .intro__mark { position: relative; display: grid; justify-items: center; gap: 22px; animation: it-exit .7s cubic-bezier(.65, 0, .35, 1) 2.1s forwards; }
  .intro__logo { position: relative; width: clamp(210px, 24vw, 300px); }
  .intro__logo svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* U: trazo + luz en la punta */
  .intro .it-mask { stroke-dasharray: 1; stroke-dashoffset: 1; animation: it-draw .8s cubic-bezier(.65, 0, .35, 1) .2s forwards; }
  .intro .it-tracer {
    offset-rotate: 0deg; offset-distance: 0%; opacity: 0;
    filter: drop-shadow(0 0 6px rgba(110, 66, 153, .8));
    animation: it-trace .8s cubic-bezier(.65, 0, .35, 1) .2s forwards;
  }
  /* Pin: caída, compresión y asentamiento; ping naranja en la punta */
  .intro .it-pin { transform-box: fill-box; transform-origin: 50% 100%; opacity: 0; animation: it-drop .85s .85s forwards; }
  .intro .it-ping { fill: none; stroke: var(--u-pin); stroke-width: 1.3; opacity: 0; transform-box: fill-box; transform-origin: center; animation: it-ping 1.1s cubic-bezier(.22, 1, .36, 1) 1.28s forwards; }
  /* Logotipo: se contrae desde un tracking amplio */
  .intro .it-l { transform-box: fill-box; opacity: 0; animation: it-letter .9s cubic-bezier(.22, 1, .36, 1) forwards; animation-delay: calc(1.1s + var(--i) * 40ms); }

  /* Brillo que barre el logo al final */
  .intro__sheen {
    position: absolute; inset: 0; pointer-events: none; mix-blend-mode: soft-light;
    -webkit-mask: url(/brand/urbetrack-logo-vertical-color.svg) center / 100% 100% no-repeat; mask: url(/brand/urbetrack-logo-vertical-color.svg) center / 100% 100% no-repeat;
    background: linear-gradient(105deg, transparent 45%, rgba(255, 255, 255, .85) 50%, transparent 55%);
    background-size: 250% 100%; background-position: 120% 0; opacity: 0;
    animation: it-sheen 1s cubic-bezier(.45, 0, .2, 1) 1.6s forwards;
  }
  .intro__sig {
    font-size: clamp(.95rem, .85rem + .35vw, 1.15rem); font-weight: 300; letter-spacing: .02em; color: var(--u-texto-suave);
    opacity: 0; transform: translateY(8px); animation: it-rise .8s cubic-bezier(.22, 1, .36, 1) 1.55s forwards;
  }
  .intro__bar { position: relative; width: clamp(150px, 16vw, 200px); height: 3px; border-radius: 3px; background: var(--u-lavanda-2); overflow: hidden; opacity: 0; animation: it-fade .4s ease .25s forwards; }
  .intro__bar i { position: absolute; inset: 0; background: var(--u-grad); transform-origin: left; transform: scaleX(0); animation: it-load 1.8s cubic-bezier(.65, 0, .35, 1) .25s forwards; }

  @keyframes it-draw { to { stroke-dashoffset: 0; } }
  @keyframes it-trace { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 85% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes it-drop {
    0% { opacity: 0; transform: translateY(-160%) scale(.9); animation-timing-function: cubic-bezier(.55, 0, .9, .45); }
    14% { opacity: 1; }
    55% { opacity: 1; transform: translateY(0) scale(1.12, .82); animation-timing-function: cubic-bezier(.22, 1, .36, 1); }
    77% { opacity: 1; transform: translateY(-9%) scale(.97, 1.05); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes it-ping { 0% { opacity: .95; transform: scale(.3); } 100% { opacity: 0; transform: scale(3); } }
  @keyframes it-rings { 0% { opacity: 0; transform: scale(.55); } 25% { opacity: 1; } 100% { opacity: 0; transform: scale(1.35); } }
  @keyframes it-letter { from { opacity: 0; transform: translate(calc(var(--o) * 14%), 30%); filter: blur(3px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes it-sheen { 0% { opacity: 0; background-position: 130% 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; background-position: -30% 0; } }
  @keyframes it-rise { to { opacity: 1; transform: none; } }
  @keyframes it-load { 0% { transform: scaleX(0); } 55% { transform: scaleX(.68); } 100% { transform: scaleX(1); } }
  @keyframes it-fade { to { opacity: 1; } }
  @keyframes it-glow { from { opacity: 0; transform: scale(.55); } to { opacity: 1; transform: none; } }
  @keyframes it-exit { to { opacity: 0; transform: translateY(-24px) scale(1.03); filter: blur(4px); } }
  @keyframes it-curtain { 0% { clip-path: inset(0 0 0 0); } 100% { clip-path: inset(0 0 100% 0); visibility: hidden; pointer-events: none; } }

  /* El hero entra mientras sube la cortina */
  html[data-intro="play"] .in, html[data-intro="done"] .in { animation-delay: calc(var(--d, 0s) + 2.3s) !important; }
  html[data-intro="play"] .rv-line.in > span, html[data-intro="done"] .rv-line.in > span { animation-delay: calc(var(--d, 0s) + 2.3s) !important; }
  html[data-intro="skipped"] .in, html[data-intro="skipped"] .rv-line.in > span { animation-delay: var(--d, 0s) !important; }

  @media (prefers-reduced-motion: reduce) { .intro { display: none !important; } }
</style>

<script>
  const d = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && d.dataset.intro === 'play') {
    let finished = false;
    const finish = (skipped: boolean) => {
      if (finished) return;
      finished = true;
      d.dataset.intro = skipped ? 'skipped' : 'done';
      d.style.overflow = '';
      window.dispatchEvent(new Event('u:intro-done'));
      removeEventListener('keydown', onKey);
    };
    const onKey = () => finish(true);
    el.addEventListener('click', () => finish(true));
    addEventListener('keydown', onKey);
    el.addEventListener('animationend', (e) => { if (e.animationName === 'it-curtain') finish(false); });
    setTimeout(() => finish(false), 3600); // resguardo
  }
</script>
