---
/** Acordeón nativo (accesible sin JS) + JSON-LD FAQPage generado desde el mismo contenido. */
import type { FaqItem } from '../data/types';
interface Props { items: FaqItem[]; ld?: boolean; openFirst?: boolean }
const { items, ld = true, openFirst = true } = Astro.props;
const json = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---
<div class="acc">
  {items.map((it, i) => (
    <details open={openFirst && i === 0}>
      <summary>{it.q}<span class="pm" aria-hidden="true"></span></summary>
      <div class="acc__body"><p>{it.a}</p></div>
    </details>
  ))}
</div>
{ld && <script type="application/ld+json" set:html={JSON.stringify(json)} />}
