---
import SectionHead from '../SectionHead.astro';
import PresenceMap from '../demos/PresenceMap.astro';
import Evidence from '../Evidence.astro';
import Icon from '../Icon.astro';
import { offices, milestones, teamSize } from '../../data/site';
---
<section class="section scale sf-blanco" id="empresa" aria-labelledby="scale-t">
  <div class="wrap">
    <div class="scale__top">
      <SectionHead id="scale-t" kicker="La empresa" light="Una empresa de la región," bold="con equipo en cinco países." lead="Casa central en Buenos Aires y oficinas en México, Colombia, Chile y España. Un mismo equipo diseña el software, instala los equipos y acompaña la operación." />
      <dl class="scale__facts">
        <div data-rv><dt>Desde</dt><dd class="num">2007</dd><Evidence ev={{ level: 'comprobado', note: 'contrato social de Pagustech S.R.L.' }} /></div>
        <div data-rv style="--d:.06s"><dt>{teamSize.label}</dt><dd class="num">{teamSize.prefix}{teamSize.value}</dd><Evidence ev={teamSize.evidence} /></div>
        <div data-rv style="--d:.12s"><dt>oficinas con equipo propio</dt><dd class="num">5</dd><Evidence ev={{ level: 'declarado', note: 'urbetrack.com; sociedades en España y Colombia comprobadas' }} /></div>
        <div data-rv style="--d:.18s"><dt>Soporte</dt><dd>24x7</dd><Evidence ev={{ level: 'declarado', note: 'Mesa de Ayuda' }} /></div>
      </dl>
    </div>

    <div class="scale__mid">
      <div class="scale__map" data-rv><PresenceMap /></div>
      <ul class="scale__offices" role="list">
        {offices.map((o, i) => (
          <li data-rv style={`--d:${i * 0.05}s`}>
            <img src={o.flag} alt="" width="24" height="24" loading="lazy" />
            <div><b>{o.city}</b><span>{o.country} · {o.role}</span></div>
          </li>
        ))}
      </ul>
    </div>

    <div class="scale__photos">
      <figure data-rv>
        <img src="/img/iswa-2025-stand.webp" alt="Stand de Urbetrack en el Congreso Mundial ISWA 2025 en Buenos Aires" width="900" height="600" loading="lazy" decoding="async" />
        <figcaption>Stand de Urbetrack en el Congreso Mundial ISWA 2025, donde fue sponsor diamante.</figcaption>
      </figure>
      <figure data-rv style="--d:.08s">
        <img src="/img/iswa-2025-ader.webp" alt="Pablo Ader, CEO de Urbetrack, en su charla en ISWA 2025" width="900" height="600" loading="lazy" decoding="async" />
        <figcaption>Pablo Ader, CEO, en “El Nuevo Pulso del Aseo Urbano”, ISWA 2025.</figcaption>
      </figure>
    </div>

    <ol class="scale__line" role="list" aria-label="Hitos">
      {milestones.map((m, i) => (
        <li data-rv style={`--d:${i * 0.05}s`}>
          <span class="num">{m.year}</span>
          <p>{m.text}</p>
        </li>
      ))}
    </ol>
    <a class="link-arrow scale__more" href="/empresa"><span>Conocer la empresa</span><Icon name="arrow" /></a>
  </div>
</section>
<style>
  .scale__top { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 80px); align-items: end; }
  .scale__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 32px; }
  .scale__facts div { display: grid; gap: 4px; justify-items: start; padding-top: 16px; border-top: 1px solid var(--u-linea); }
  .scale__facts dt { font-size: var(--fs-small); font-weight: 600; color: var(--u-texto-suave); order: 2; }
  .scale__facts dd { margin: 0; font-size: var(--fs-stat); font-weight: 800; letter-spacing: -.045em; line-height: 1; color: var(--u-violeta); order: 1; }
  .scale__facts :global(.ev) { order: 3; margin-top: 4px; }
  .scale__mid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(24px, 4vw, 64px); align-items: center; margin-top: clamp(40px, 5vw, 72px); }
  .scale__offices { display: grid; gap: 4px; }
  .scale__offices li { display: flex; gap: 14px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--u-linea); }
  .scale__offices img { border-radius: 50%; flex: none; }
  .scale__offices b { display: block; font-weight: 800; color: var(--u-texto); }
  .scale__offices span { display: block; font-size: var(--fs-micro); color: var(--u-texto-suave); font-weight: 600; }
  .scale__photos { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; margin-top: clamp(40px, 5vw, 72px); }
  .scale__photos figure { display: grid; gap: 10px; }
  .scale__photos img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--r-glass); }
  .scale__photos figcaption { font-size: var(--fs-micro); color: var(--u-texto-suave); font-weight: 500; }
  .scale__line { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0; margin-top: clamp(48px, 6vw, 88px); border-top: 2px solid var(--u-linea); position: relative; }
  .scale__line li { position: relative; padding: 22px 16px 0 0; }
  .scale__line li::before { content: ""; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 2.5px solid var(--u-violeta); }
  .scale__line li:last-child::before { border-color: var(--u-pin); background: var(--u-pin); }
  .scale__line span { font-size: 1.25rem; font-weight: 800; color: var(--u-texto); letter-spacing: -.02em; }
  .scale__line p { font-size: var(--fs-micro); line-height: 1.45; color: var(--u-texto-suave); margin-top: 6px; }
  .scale__more { margin-top: 36px; }
  @media (max-width: 1100px) {
    .scale__top, .scale__mid { grid-template-columns: 1fr; }
    .scale__line { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 28px; border-top: 0; }
    .scale__line li { border-top: 2px solid var(--u-linea); }
  }
  @media (max-width: 640px) {
    .scale__photos { grid-template-columns: 1fr; }
    .scale__line { grid-template-columns: 1fr 1fr; }
  }
</style>
