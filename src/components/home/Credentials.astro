---
import Stat from '../Stat.astro';
import Evidence from '../Evidence.astro';
import { corporateStats, credentials, offices } from '../../data/site';
---
<section class="cred sf-blanco" aria-label="Urbetrack en cifras y credenciales">
  <div class="wrap">
    <div class="cred__grid">
      <ul class="cred__stats" role="list">
        {corporateStats.map((m, i) => (
          <li data-rv style={`--d:${i * 0.07}s`}><Stat m={m} showEv={false} /></li>
        ))}
      </ul>
      <div class="cred__meta" data-rv style="--d:.3s">
        <Evidence ev={corporateStats[0].evidence} />
        <p class="cred__flags" aria-label="Oficinas en cinco países">
          {offices.map((o) => <span title={`${o.country} · ${o.city}`}><img src={o.flag} alt="" width="22" height="22" loading="lazy" />{o.country}</span>)}
        </p>
      </div>
    </div>
    <ul class="cred__list" role="list">
      {credentials.map((c, i) => (
        <li data-rv style={`--d:${0.1 + i * 0.06}s`}>
          {c.img ? <img src={c.img} alt="" width="92" height="30" loading="lazy" class="cred__seal" /> : <span class="cred__mark" aria-hidden="true"></span>}
          <div>
            <p class="cred__t">{c.title}</p>
            <p class="cred__d">{c.detail}</p>
            <Evidence ev={c.evidence} short />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .cred { padding: clamp(48px, 5vw, 80px) 0; border-bottom: 1px solid var(--u-linea); }
  .cred__grid { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
  .cred__stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .cred__stats :global(.stat__v) { font-size: clamp(2.3rem, 1.6rem + 2vw, 3.6rem); }
  .cred__meta { display: grid; gap: 14px; justify-items: end; text-align: right; }
  .cred__flags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px 14px; font-size: var(--fs-micro); font-weight: 600; color: var(--u-texto-suave); }
  .cred__flags span { display: inline-flex; align-items: center; gap: 6px; }
  .cred__flags img { border-radius: 50%; }
  .cred__list { margin-top: clamp(32px, 4vw, 56px); padding-top: 28px; border-top: 1px solid var(--u-linea); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .cred__list li { display: flex; gap: 14px; align-items: flex-start; }
  .cred__list li > div { display: grid; gap: 4px; justify-items: start; }
  .cred__seal { width: 76px; height: auto; border-radius: 4px; flex: none; margin-top: 2px; }
  .cred__mark { width: 10px; height: 10px; margin-top: 7px; border-radius: 50%; background: var(--u-violeta); box-shadow: 0 0 0 5px var(--u-lavanda); flex: none; }
  .cred__t { font-weight: 800; color: var(--u-texto); line-height: 1.25; }
  .cred__d { font-size: var(--fs-micro); color: var(--u-texto-suave); font-weight: 500; line-height: 1.4; margin-bottom: 4px; }
  @media (max-width: 1100px) {
    .cred__grid { grid-template-columns: 1fr; }
    .cred__meta { justify-items: start; text-align: left; }
    .cred__flags { justify-content: flex-start; }
    .cred__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .cred__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }
    .cred__list { grid-template-columns: 1fr; }
  }
</style>
