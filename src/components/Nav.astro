---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav, solutionGroups, sectorGroups } from '../data/nav';
import { site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.split('/').slice(0, 2).join('/')));
const megas = { soluciones: solutionGroups, sectores: sectorGroups };
---
<header class="nav" id="nav" data-state="top">
  <div class="wrap nav__wrap">
    <div class="nav__pill">
      <a class="nav__logo" href="/" aria-label="Urbetrack, ir al inicio">
        <Logo variant="horizontal" animate="load" label="Urbetrack" />
      </a>

      <nav class="nav__links" aria-label="Principal">
        <ul role="list">
          {mainNav.map((item) => (
            <li class:list={{ 'has-mega': !!item.mega }}>
              {item.mega ? (
                <button class:list={['nav__a', { 'is-active': isActive(item.href) || (item.mega === 'sectores' && path.startsWith('/sectores')) }]} type="button" aria-expanded="false" aria-controls={`mega-${item.mega}`} data-mega={item.mega}>
                  {item.label}<Icon name="chevron" size={14} class="nav__chev" />
                </button>
              ) : (
                <a class:list={['nav__a', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="nav__cta">
        <a class="nav__login" href={site.loginUrl} rel="noopener">Ingresar</a>
        <a class="btn btn--demo btn--sm" href="/contacto" data-cta="nav">Solicitar demo</a>
        <button class="nav__burger" type="button" aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
          <span></span><span></span>
        </button>
      </div>
      <div class="nav__progress" aria-hidden="true"><i></i></div>
    </div>

    {Object.entries(megas).map(([key, groups]) => (
      <div class="mega" id={`mega-${key}`} data-mega-panel={key} hidden>
        <div class="mega__in">
          <div class="mega__groups" style={`--cols:${groups.length}`}>
            {groups.map((g) => (
              <div class="mega__group">
                <p class="mega__title">{g.title}</p>
                <ul role="list">
                  {g.links.map((l) => (
                    <li>
                      <a class="mega__link" href={l.href}>
                        {l.icon && <span class="tile-ico tile-ico--sm"><Icon name={l.icon} /></span>}
                        <span><b>{l.label}</b><small>{l.desc}</small></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <aside class="mega__aside">
            {key === 'soluciones' ? (
              <>
                <p class="kicker">Por dónde empezar</p>
                <p class="mega__aside-t">¿No sabes qué módulo necesitas?</p>
                <p class="t-small t-muted">Un especialista releva tu operación y arma la propuesta a medida.</p>
                <a class="link-arrow" href="/soluciones"><span>Ver todas las soluciones</span><Icon name="arrow" /></a>
              </>
            ) : (
              <>
                <p class="kicker">Caso destacado</p>
                <p class="mega__aside-t">Ciudad de Buenos Aires: telemetría sobre toda la higiene urbana desde 2017.</p>
                <span class="ev ev--comprobado">Comprobado · informe de gestión GCBA</span>
                <a class="link-arrow" href="/casos/gcba"><span>Leer el caso</span><Icon name="arrow" /></a>
              </>
            )}
          </aside>
        </div>
      </div>
    ))}
  </div>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu__in wrap">
    <nav aria-label="Menú móvil">
      <details class="menu__grp">
        <summary>Soluciones <Icon name="plus" size={20} /></summary>
        {solutionGroups.map((g) => (
          <div class="menu__sub"><p>{g.title}</p><ul role="list">{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
        ))}
        <a class="menu__all" href="/soluciones">Todas las soluciones</a>
      </details>
      <details class="menu__grp">
        <summary>Sectores <Icon name="plus" size={20} /></summary>
        {sectorGroups.map((g) => (
          <div class="menu__sub"><p>{g.title}</p><ul role="list">{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
        ))}
      </details>
      <a class="menu__a" href="/plataforma">Plataforma</a>
      <a class="menu__a" href="/casos">Casos</a>
      <a class="menu__a" href="/empresa">Empresa</a>
      <a class="menu__a" href="/recursos/blog">Recursos</a>
      <a class="menu__a" href="/contacto">Contacto</a>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--demo btn--block" href="/contacto" data-cta="menu">Solicitar demo <Icon name="arrow" class="arrow" /></a>
      <a class="btn btn--ghost btn--block" href={site.loginUrl} rel="noopener">Ingresar a la plataforma</a>
      <p class="t-micro t-muted">{site.email} · {site.phone}</p>
    </div>
  </div>
</div>

<style is:global>
  .nav { position: fixed; inset: 0 0 auto; z-index: 100; padding-top: 12px; transition: transform .5s var(--ease-out); pointer-events: none; }
  .nav[data-hidden="true"] { transform: translateY(calc(-100% - 12px)); }
  .nav__wrap { position: relative; }
  .nav__pill {
    pointer-events: auto; position: relative; display: flex; align-items: center; gap: 12px;
    height: 60px; padding: 0 10px 0 22px; border-radius: 16px;
    background: rgba(255, 255, 255, .82); border: 1px solid rgba(220, 207, 234, .7);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset, 0 10px 30px -18px rgba(23, 27, 37, .35);
    -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4);
    transition: background-color .3s, box-shadow .3s;
  }
  .nav[data-state="top"] .nav__pill { background: rgba(255, 255, 255, .7); box-shadow: 0 1px 0 rgba(255, 255, 255, .9) inset; }
  .nav__logo { display: block; width: 148px; flex: none; margin-right: auto; }
  .nav__links ul { display: flex; gap: 2px; }
  .nav__a {
    display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px; border-radius: 10px;
    border: 0; background: transparent; font-size: .9rem; font-weight: 600; color: var(--u-texto); text-decoration: none;
    transition: background-color var(--t-micro), color var(--t-micro);
  }
  .nav__a:hover, .nav__a[aria-expanded="true"] { background: var(--u-lavanda); color: var(--u-violeta); }
  .nav__a.is-active { color: var(--u-violeta); }
  .nav__a.is-active::after { content: ""; position: absolute; }
  .nav__chev { transition: transform var(--t-micro) var(--ease-out); }
  .nav__a[aria-expanded="true"] .nav__chev { transform: rotate(180deg); }
  .nav__cta { display: flex; align-items: center; gap: 8px; margin-left: 8px; }
  .nav__login { font-size: .875rem; font-weight: 700; color: var(--u-violeta); text-decoration: none; padding: 10px 12px; border-radius: 10px; }
  .nav__login:hover { background: var(--u-lavanda); }
  .nav__burger { display: none; width: 44px; height: 44px; border: 0; border-radius: 10px; background: var(--u-lavanda); position: relative; }
  .nav__burger span { position: absolute; left: 13px; right: 13px; height: 2px; border-radius: 2px; background: var(--u-violeta); transition: transform .35s var(--ease-out), top .35s var(--ease-out); }
  .nav__burger span:first-child { top: 17px; }
  .nav__burger span:last-child { top: 25px; }
  .nav__burger[aria-expanded="true"] span:first-child { top: 21px; transform: rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:last-child { top: 21px; transform: rotate(-45deg); }
  .nav__progress { position: absolute; left: 16px; right: 16px; bottom: -1px; height: 2px; overflow: hidden; border-radius: 2px; }
  .nav__progress i { display: block; height: 100%; background: var(--u-grad); transform-origin: left; transform: scaleX(var(--p, 0)); }

  .mega { pointer-events: auto; position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 8px); }
  .mega__in {
    display: grid; grid-template-columns: 1fr 300px; gap: 0; border-radius: 18px; overflow: hidden;
    background: #fff; border: 1px solid var(--u-linea); box-shadow: 0 30px 70px -30px rgba(23, 27, 37, .35);
    transform-origin: top center; animation: mega-in .36s var(--ease-out) both;
  }
  @keyframes mega-in { from { opacity: 0; transform: translateY(-8px) scale(.99); } to { opacity: 1; transform: none; } }
  .mega__groups { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 28px; padding: 28px; }
  .mega__title { font-size: var(--fs-micro); font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--u-texto-suave); margin: 0 0 12px 10px; }
  .mega__link { display: flex; gap: 14px; align-items: flex-start; padding: 10px; border-radius: 12px; text-decoration: none; transition: background-color var(--t-micro); }
  .mega__link:hover { background: var(--u-estudio); }
  .mega__link:hover b { color: var(--u-violeta); }
  .mega__link b { display: block; font-size: .95rem; font-weight: 700; color: var(--u-texto); line-height: 1.3; }
  .mega__link small { display: block; font-size: var(--fs-micro); color: var(--u-texto-suave); line-height: 1.4; margin-top: 2px; }
  .mega__aside { background: linear-gradient(170deg, var(--u-estudio), var(--u-lavanda)); padding: 28px; display: grid; align-content: start; gap: 12px; }
  .mega__aside-t { font-size: 1.05rem; font-weight: 700; line-height: 1.35; color: var(--u-texto); }

  .menu { position: fixed; inset: 0; z-index: 90; background: var(--u-estudio); overflow-y: auto; padding-top: calc(var(--nav-h) + 20px); }
  .menu:not([hidden]) { animation: menu-in .4s var(--ease-out) both; }
  @keyframes menu-in { from { opacity: 0; } to { opacity: 1; } }
  .menu__in { display: grid; gap: 32px; padding-bottom: 32px; min-height: calc(100dvh - var(--nav-h) - 20px); align-content: space-between; }
  .menu nav > * { border-bottom: 1px solid var(--u-linea); }
  .menu__grp summary, .menu__a {
    display: flex; justify-content: space-between; align-items: center; padding: 18px 0; list-style: none;
    font-size: 1.6rem; font-weight: 300; letter-spacing: -.02em; color: var(--u-texto); text-decoration: none; cursor: pointer;
  }
  .menu__grp summary::-webkit-details-marker { display: none; }
  .menu__grp[open] summary { font-weight: 800; color: var(--u-violeta); }
  .menu__grp summary svg { color: var(--u-violeta); transition: transform var(--t-micro); }
  .menu__grp[open] summary svg { transform: rotate(45deg); }
  .menu__sub { padding: 0 0 12px; }
  .menu__sub p { font-size: var(--fs-micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--u-texto-suave); margin-bottom: 4px; }
  .menu__sub a, .menu__all { display: block; padding: 10px 0; font-size: 1.05rem; font-weight: 600; color: var(--u-texto); text-decoration: none; }
  .menu__all { color: var(--u-violeta); padding-bottom: 20px; }
  .menu__foot { display: grid; gap: 10px; }

  @media (max-width: 1180px) {
    .nav__links, .nav__login { display: none; }
    .nav__burger { display: inline-block; }
    .mega { display: none; }
  }
  @media (max-width: 520px) {
    .nav { padding-top: 8px; }
    .nav__pill { height: 56px; padding-left: 16px; }
    .nav__logo { width: 124px; }
    .nav__cta .btn--demo { display: none; }
  }
  @media (min-width: 1181px) { .menu { display: none !important; } }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const bar = nav.querySelector<HTMLElement>('.nav__progress i')!;
  let lastY = scrollY, ticking = false;
  function onScroll() {
    const y = scrollY;
    const h = document.documentElement.scrollHeight - innerHeight;
    bar.style.setProperty('--p', String(h > 0 ? Math.min(1, y / h) : 0));
    nav.dataset.state = y < 24 ? 'top' : 'scrolled';
    const menuOpen = document.body.classList.contains('menu-open') || nav.querySelector('[aria-expanded="true"]');
    if (!menuOpen) nav.dataset.hidden = y > lastY && y > 320 ? 'true' : 'false';
    lastY = y; ticking = false;
  }
  addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(onScroll); ticking = true; } }, { passive: true });
  onScroll();

  // Mega menús: clic y teclado; apertura por hover con intención en puntero fino
  const buttons = [...nav.querySelectorAll<HTMLButtonElement>('[data-mega]')];
  let closeTimer: number | undefined;
  function setOpen(btn: HTMLButtonElement | null) {
    buttons.forEach((b) => {
      const open = b === btn;
      b.setAttribute('aria-expanded', String(open));
      const panel = document.getElementById(b.getAttribute('aria-controls')!)!;
      panel.hidden = !open;
    });
  }
  buttons.forEach((b) => {
    b.addEventListener('click', () => setOpen(b.getAttribute('aria-expanded') === 'true' ? null : b));
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      b.parentElement!.addEventListener('mouseenter', () => { clearTimeout(closeTimer); closeTimer = window.setTimeout(() => setOpen(b), 90); });
    }
  });
  nav.addEventListener('mouseleave', () => { clearTimeout(closeTimer); closeTimer = window.setTimeout(() => setOpen(null), 220); });
  nav.querySelectorAll('.mega').forEach((m) => m.addEventListener('mouseenter', () => clearTimeout(closeTimer)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const open = buttons.find((b) => b.getAttribute('aria-expanded') === 'true');
      if (open) { setOpen(null); open.focus(); }
      if (document.body.classList.contains('menu-open')) toggleMenu(false);
    }
  });
  document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setOpen(null); });

  // Menú móvil
  const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
  const menu = document.getElementById('menu')!;
  function toggleMenu(force?: boolean) {
    const open = force ?? burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    nav.dataset.hidden = 'false';
  }
  burger.addEventListener('click', () => toggleMenu());
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) toggleMenu(false); });
</script>
