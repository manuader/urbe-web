---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Página no encontrada" noindex>
  <section class="nf sf-estudio">
    <div class="wrap nf__in">
      <Logo variant="iso" animate="view" class="nf__iso" />
      <p class="kicker">Error 404</p>
      <h1 class="t-mix t-h1">Esta ruta <b class="v">no tiene registro.</b></h1>
      <hr class="rule rule--center" />
      <p class="t-lead">La página que buscas se movió o no existe. Si llegaste desde el sitio anterior, es posible que haya cambiado de dirección.</p>
      <div class="nf__ctas">
        <a class="btn btn--primario" href="/">Ir al inicio <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--ghost" href="/soluciones">Ver soluciones</a>
        <a class="btn btn--ghost" href="/contacto">Contacto</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 80vh; display: grid; align-items: center; padding: calc(var(--nav-h) + 60px) 0 80px; }
  .nf__in { display: grid; gap: 22px; justify-items: center; text-align: center; }
  .nf__in :global(.nf__iso) { width: 64px; }
  .nf__in .t-lead { margin-inline: auto; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
</style>
